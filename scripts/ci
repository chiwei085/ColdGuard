#!/bin/sh
# Compatibility check for one supported distro. Acceptance stays local.
# Runs as root in a clean container with the repository as the working directory.
set -eu

# Package names from the [apt] table. Minimum versions are left to doctor.
packages=$(sed -n '/^\[apt\]/,/^\[/p' toolchain.toml | sed -n 's/^"\{0,1\}\([a-z0-9.+-]*\)"\{0,1\} *=.*/\1/p')
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
# shellcheck disable=SC2086
apt-get install -y -qq --no-install-recommends $packages >/dev/null

curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
curl -fsSL https://astral.sh/uv/install.sh | sh
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

# setup ends with doctor, which boots the firmware and checks MQTT.
cargo run --locked -- setup
cargo test --locked --workspace
